# ============================================
# WISHORA — .gitignore
# ============================================

# ---- Dependencies ----
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---- Next.js Build Output ----
.next/
out/
build/
dist/

# ---- Testing & Coverage ----
coverage/
*.lcov
.nyc_output/

# ---- Environment Variables ----
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# .env.example is committed intentionally

# ---- OS Generated Files ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---- IDE / Editor ----
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ---- Debug Logs ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# ---- TypeScript ----
*.tsbuildinfo
next-env.d.ts

# ---- Vercel ----
.vercel

# ---- Misc ----
*.pem
*.key
*.cert
*.log
*.zip
wishora_zip.zip
frontend/
