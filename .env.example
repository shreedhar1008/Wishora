# ============================================
# WISHORA ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env.local and fill in values

# ---- Supabase (optional, app works in demo mode without these) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- App Configuration ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Wishora

# ---- Admin ----
# Email address that has admin access
ADMIN_EMAIL=admin@wishora.app

# ---- AI Message Suggestions (optional) ----
# Set this to enable AI-powered message suggestions
# Supports OpenAI API compatible endpoints
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1

# ---- Media Storage ----
# Max file size in MB
NEXT_PUBLIC_MAX_UPLOAD_SIZE_MB=10
# Allowed image MIME types
NEXT_PUBLIC_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif

# ---- Payment (future, not active) ----
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
