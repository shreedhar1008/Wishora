# -----------------------------------------------------------------------------
# WISHORA - PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# -----------------------------------------------------------------------------

# --- SUPABASE CONFIGURATION ---
# These are required to connect to your Supabase project.
# You can find these in your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- ADMIN CONFIGURATION ---
# Set this to the email address of the administrator account.
# Users matching this email will have access to the /admin dashboard.
ADMIN_EMAIL=admin@wishora.app

# --- APPLICATION SETTINGS ---
# The base URL of the application, used for metadata and sharing links.
NEXT_PUBLIC_APP_URL=https://wishora.app
